<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WildChat Lens — Analytics Platform</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&family=Sora:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F4F6FA;
    --surface: #FFFFFF;
    --surface2: #F0F3F8;
    --border: #E2E8F2;
    --border2: #C8D3E8;
    --text: #0F1C36;
    --text2: #4A5872;
    --text3: #8A96AE;
    --accent: #1A5CFF;
    --accent2: #0A3ECC;
    --accent-soft: #EBF0FF;
    --green: #00B67A;
    --green-soft: #E6F9F2;
    --orange: #FF8C00;
    --orange-soft: #FFF4E5;
    --red: #E8294E;
    --red-soft: #FEE8ED;
    --purple: #7B4FD4;
    --purple-soft: #F1ECFD;
    --teal: #00A3B4;
    --teal-soft: #E5F7F9;
    --gold: #D4A017;
    --shadow: 0 1px 4px rgba(15,28,54,0.07), 0 4px 16px rgba(15,28,54,0.05);
    --shadow-lg: 0 8px 32px rgba(15,28,54,0.12);
    --radius: 12px;
    --radius-sm: 8px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    font-size: 13px;
    line-height: 1.5;
  }

  /* ── TOP NAV ── */
  .topnav {
    height: 56px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 20px;
    gap: 16px;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 6px rgba(15,28,54,0.06);
  }
  .brand {
    display: flex; align-items: center; gap: 10px; margin-right: 8px;
    font-family: 'Sora', sans-serif; font-size: 16px; font-weight: 700;
    color: var(--text);
  }
  .brand-dot {
    width: 28px; height: 28px; border-radius: 8px;
    background: linear-gradient(135deg, var(--accent), #00AAFF);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 13px; font-weight: 700;
  }
  .nav-pill {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--surface); cursor: pointer; font-size: 12px;
    font-weight: 500; color: var(--text2); transition: all .15s;
    user-select: none;
  }
  .nav-pill:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .nav-pill.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .nav-sep { width: 1px; height: 24px; background: var(--border); margin: 0 4px; }
  .nav-spacer { flex: 1; }
  .btn {
    display: flex; align-items: center; gap: 6px;
    padding: 7px 14px; border-radius: 8px; border: none;
    cursor: pointer; font-size: 12px; font-weight: 600;
    font-family: 'DM Sans', sans-serif; transition: all .15s;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent2); }
  .btn-outline { background: var(--surface); border: 1px solid var(--border); color: var(--text2); }
  .btn-outline:hover { border-color: var(--accent); color: var(--accent); }

  /* ── LAYOUT ── */
  .layout { display: flex; height: calc(100vh - 56px); overflow: hidden; }

  /* ── LEFT SIDEBAR ── */
  .sidebar {
    width: 220px; min-width: 220px; background: var(--surface);
    border-right: 1px solid var(--border); overflow-y: auto;
    display: flex; flex-direction: column;
  }
  .sidebar-section { padding: 16px 12px 6px; }
  .sidebar-label {
    font-size: 10px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--text3); padding: 0 8px 8px;
  }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: var(--radius-sm);
    cursor: pointer; font-size: 12.5px; font-weight: 500;
    color: var(--text2); transition: all .12s; margin-bottom: 2px;
  }
  .nav-item:hover { background: var(--surface2); color: var(--text); }
  .nav-item.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .nav-item svg { opacity: .6; flex-shrink: 0; }
  .nav-item.active svg { opacity: 1; }
  .nav-badge {
    margin-left: auto; background: var(--accent); color: #fff;
    font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 10px;
  }

  /* ── MAIN CONTENT ── */
  .main { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 16px; }

  /* ── KPI ROW ── */
  .kpi-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .kpi-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 16px 18px;
    box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 6px;
    transition: box-shadow .15s;
  }
  .kpi-card:hover { box-shadow: var(--shadow-lg); }
  .kpi-label { font-size: 10.5px; font-weight: 600; color: var(--text3); letter-spacing: .04em; text-transform: uppercase; }
  .kpi-value { font-family: 'Sora', sans-serif; font-size: 26px; font-weight: 700; color: var(--text); line-height: 1; }
  .kpi-sub { font-size: 11px; color: var(--text3); }
  .kpi-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10.5px; font-weight: 600; padding: 3px 8px;
    border-radius: 6px; width: fit-content;
  }
  .kpi-badge.green { background: var(--green-soft); color: var(--green); }
  .kpi-badge.blue { background: var(--accent-soft); color: var(--accent); }
  .kpi-badge.orange { background: var(--orange-soft); color: var(--orange); }
  .kpi-badge.red { background: var(--red-soft); color: var(--red); }

  /* ── FILTER TOOLBAR ── */
  .filter-bar {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 12px 16px;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    box-shadow: var(--shadow);
  }
  .filter-search {
    flex: 1; min-width: 200px; display: flex; align-items: center; gap: 8px;
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 8px; padding: 7px 12px;
  }
  .filter-search input {
    border: none; background: transparent; font-family: 'DM Sans', sans-serif;
    font-size: 12.5px; color: var(--text); outline: none; width: 100%;
  }
  .filter-search input::placeholder { color: var(--text3); }
  .filter-tag {
    display: flex; align-items: center; gap: 5px;
    background: var(--accent-soft); color: var(--accent);
    border: 1px solid rgba(26,92,255,.2); border-radius: 6px;
    padding: 4px 10px; font-size: 11.5px; font-weight: 600; cursor: pointer;
  }
  .filter-tag .remove { opacity: .6; font-size: 12px; }
  .filter-tag:hover .remove { opacity: 1; }
  .filter-tag.green { background: var(--green-soft); color: var(--green); border-color: rgba(0,182,122,.2); }
  .filter-tag.purple { background: var(--purple-soft); color: var(--purple); border-color: rgba(123,79,212,.2); }
  .filter-count { font-size: 11px; color: var(--text3); font-family: 'DM Mono', monospace; margin-left: auto; }
  .presets-label { font-size: 11px; font-weight: 600; color: var(--text2); white-space: nowrap; }

  /* ── DATE SLIDER ── */
  .date-slider-bar {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 12px 18px;
    display: flex; align-items: center; gap: 16px; box-shadow: var(--shadow);
  }
  .slider-label { font-size: 11px; font-weight: 600; color: var(--text3); white-space: nowrap; text-transform: uppercase; letter-spacing: .04em; }
  .slider-wrap { flex: 1; position: relative; }
  .range-track {
    width: 100%; height: 4px; background: var(--border2); border-radius: 2px;
    position: relative; cursor: pointer;
  }
  .range-fill {
    position: absolute; height: 100%; background: var(--accent); border-radius: 2px;
    left: 18%; width: 62%;
  }
  .range-thumb {
    position: absolute; width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent); border: 2.5px solid #fff; box-shadow: 0 1px 6px rgba(26,92,255,.4);
    top: 50%; transform: translate(-50%, -50%); cursor: ew-resize;
  }
  .range-thumb:nth-child(2) { left: 18%; }
  .range-thumb:nth-child(3) { left: 80%; }
  .slider-dates { display: flex; justify-content: space-between; margin-top: 4px; }
  .slider-date { font-size: 10px; font-family: 'DM Mono', monospace; color: var(--text3); }
  .slider-date.active { color: var(--accent); font-weight: 500; }
  .date-range-display {
    font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500;
    color: var(--accent); background: var(--accent-soft);
    padding: 5px 10px; border-radius: 6px; white-space: nowrap;
  }

  /* ── MID ROW ── */
  .mid-row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; }

  /* ── MAP ── */
  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: var(--shadow);
    overflow: hidden; display: flex; flex-direction: column;
  }
  .card-header {
    display: flex; align-items: center; gap: 8px;
    padding: 14px 18px; border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .card-title { font-size: 13px; font-weight: 700; color: var(--text); }
  .card-sub { font-size: 11px; color: var(--text3); margin-left: 4px; }
  .card-actions { margin-left: auto; display: flex; gap: 6px; }
  .card-body { flex: 1; padding: 0; overflow: hidden; }
  .card-body.padded { padding: 16px 18px; }

  /* MAP SVG */
  .map-container { position: relative; background: #EBF2FF; overflow: hidden; height: 280px; }
  .map-svg { width: 100%; height: 100%; }
  .map-bubble { cursor: pointer; transition: all .2s; }
  .map-bubble:hover circle { filter: brightness(1.1); }
  .map-controls {
    position: absolute; bottom: 12px; left: 12px; display: flex; gap: 6px;
  }
  .map-btn {
    width: 28px; height: 28px; background: var(--surface); border: 1px solid var(--border);
    border-radius: 6px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 14px; box-shadow: var(--shadow);
  }
  .map-btn:hover { background: var(--accent-soft); }
  .map-legend {
    position: absolute; top: 12px; right: 12px;
    background: rgba(255,255,255,.92); border: 1px solid var(--border);
    border-radius: 8px; padding: 8px 12px; font-size: 10px; color: var(--text2);
  }
  .legend-row { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
  .map-tooltip {
    position: absolute; background: var(--text); color: #fff;
    padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: 500;
    pointer-events: none; white-space: nowrap;
    transition: opacity .15s;
  }

  /* ── TOPIC CLUSTERING ── */
  .topic-list { padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; }
  .topic-row { display: flex; align-items: center; gap: 10px; }
  .topic-name { font-size: 12.5px; font-weight: 500; color: var(--text2); width: 120px; flex-shrink: 0; }
  .topic-bar-wrap { flex: 1; background: var(--surface2); border-radius: 4px; height: 8px; overflow: hidden; }
  .topic-bar { height: 100%; border-radius: 4px; transition: width .4s ease; }
  .topic-pct { font-size: 11px; font-family: 'DM Mono', monospace; font-weight: 500; color: var(--text2); width: 32px; text-align: right; }

  /* ── BOTTOM ROW ── */
  .bottom-row { display: grid; grid-template-columns: 1.2fr 1fr 0.9fr; gap: 16px; }

  /* CONVERSATION TABLE */
  .conv-table { width: 100%; border-collapse: collapse; }
  .conv-table th {
    font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--text3); padding: 8px 14px; text-align: left;
    border-bottom: 1px solid var(--border); background: var(--surface2);
  }
  .conv-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 12px; vertical-align: middle; }
  .conv-table tr:hover td { background: var(--accent-soft); cursor: pointer; }
  .conv-table tr.selected td { background: var(--accent-soft); border-left: 3px solid var(--accent); }
  .hash-code { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--text3); }
  .model-tag {
    display: inline-flex; padding: 2px 7px; border-radius: 4px;
    font-size: 10px; font-weight: 600; font-family: 'DM Mono', monospace;
  }
  .model-tag.gpt35 { background: #E8F5E9; color: #2E7D32; }
  .model-tag.gpt4 { background: #E3F2FD; color: #1565C0; }
  .lang-tag {
    display: inline-flex; padding: 2px 7px; border-radius: 4px;
    font-size: 10.5px; font-weight: 500; background: var(--surface2); color: var(--text2);
  }
  .country-flag { font-size: 14px; margin-right: 4px; }
  .status-dot {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 5px;
  }
  .status-dot::before { content:''; display:block; width:6px; height:6px; border-radius:50%; }
  .status-dot.ok { color: var(--green); background: var(--green-soft); }
  .status-dot.ok::before { background: var(--green); }
  .status-dot.redacted { color: var(--red); background: var(--red-soft); }
  .status-dot.redacted::before { background: var(--red); }

  /* CONVERSATION PREVIEW */
  .conv-preview { padding: 14px; display: flex; flex-direction: column; gap: 10px; flex: 1; overflow-y: auto; }
  .conv-meta { display: flex; gap: 6px; flex-wrap: wrap; }
  .conv-meta-chip {
    font-size: 10.5px; font-weight: 600; padding: 3px 8px; border-radius: 5px;
    background: var(--surface2); color: var(--text2);
  }
  .msg-bubble {
    border-radius: 10px; padding: 10px 13px;
    font-size: 12px; line-height: 1.55; max-width: 92%;
  }
  .msg-bubble.user { background: var(--accent-soft); color: var(--text); align-self: flex-end; }
  .msg-bubble.assistant { background: var(--surface2); color: var(--text); }
  .msg-role { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
  .msg-role.user { color: var(--accent); }
  .msg-role.assistant { color: var(--green); }
  .conv-flow-dots { display: flex; gap: 6px; padding: 6px 14px; align-items: center; }
  .flow-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .flow-label { font-size: 10px; color: var(--text3); margin-left: 4px; }
  .topic-shift-note {
    font-size: 10px; color: var(--orange); background: var(--orange-soft);
    padding: 4px 10px; border-radius: 5px; margin: 0 14px;
    font-weight: 600;
  }

  /* TRANSLATOR */
  .translator-wrap { padding: 14px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .translator-from-to { display: flex; align-items: center; gap: 6px; }
  .lang-select {
    flex: 1; background: var(--surface2); border: 1px solid var(--border);
    border-radius: 6px; padding: 6px 10px; font-family: 'DM Sans', sans-serif;
    font-size: 12px; color: var(--text); outline: none; cursor: pointer;
  }
  .swap-btn {
    width: 28px; height: 28px; border-radius: 6px; border: 1px solid var(--border);
    background: var(--surface); display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 14px; color: var(--text2); flex-shrink: 0;
  }
  .swap-btn:hover { background: var(--accent-soft); color: var(--accent); }
  .trans-textarea {
    width: 100%; border: 1px solid var(--border); border-radius: 8px;
    padding: 10px; font-family: 'DM Sans', sans-serif; font-size: 12px;
    color: var(--text); background: var(--surface2); resize: none;
    outline: none; min-height: 70px; line-height: 1.5;
  }
  .trans-textarea:focus { border-color: var(--accent); background: #fff; }
  .trans-output {
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 8px; padding: 10px; font-size: 12px; color: var(--text);
    min-height: 70px; line-height: 1.5; font-style: italic;
  }
  .trans-loading { color: var(--text3); font-style: normal; display: flex; align-items: center; gap: 6px; }
  .spin { animation: spin 1s linear infinite; display: inline-block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ETL LOG */
  .etl-list { padding: 0; }
  .etl-row {
    display: flex; align-items: center; gap: 10px; padding: 10px 16px;
    border-bottom: 1px solid var(--border); font-size: 12px;
  }
  .etl-row:last-child { border-bottom: none; }
  .etl-time { font-family: 'DM Mono', monospace; font-size: 10.5px; color: var(--text3); width: 110px; flex-shrink: 0; }
  .etl-rows { font-size: 11.5px; color: var(--text2); flex: 1; }
  .etl-status {
    padding: 2px 8px; border-radius: 5px; font-size: 10.5px; font-weight: 600;
  }
  .etl-status.success { background: var(--green-soft); color: var(--green); }
  .etl-status.partial { background: var(--orange-soft); color: var(--orange); }
  .etl-status.running { background: var(--accent-soft); color: var(--accent); }

  /* ANNOTATION */
  .annotation-list { padding: 14px; display: flex; flex-direction: column; gap: 8px; }
  .annotation-item {
    display: flex; align-items: flex-start; gap: 8px;
    background: var(--surface2); border-radius: 8px; padding: 10px 12px;
    font-size: 12px; border-left: 3px solid var(--border2);
  }
  .annotation-item.flag { border-left-color: var(--red); }
  .annotation-item.info { border-left-color: var(--accent); }
  .annotation-item.warn { border-left-color: var(--orange); }
  .ann-icon { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
  .ann-text { color: var(--text); flex: 1; line-height: 1.45; }
  .ann-add {
    display: flex; align-items: center; gap: 6px;
    color: var(--accent); font-size: 12px; font-weight: 600;
    cursor: pointer; padding: 6px 12px; border-radius: 6px;
    transition: background .12s;
  }
  .ann-add:hover { background: var(--accent-soft); }

  /* PRESETS */
  .presets-grid { padding: 14px; display: flex; flex-direction: column; gap: 6px; }
  .preset-chip {
    display: flex; align-items: center; gap: 8px; padding: 8px 12px;
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 8px; cursor: pointer; transition: all .12s; font-size: 12px;
  }
  .preset-chip:hover { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .preset-chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .preset-chip .icon { font-size: 14px; flex-shrink: 0; }
  .preset-chip .label { font-weight: 600; flex: 1; }
  .preset-chip .meta { font-size: 10.5px; opacity: .7; font-family: 'DM Mono', monospace; }

  /* USER HISTORY */
  .history-list { padding: 14px; display: flex; flex-direction: column; gap: 4px; }
  .history-item {
    display: flex; align-items: center; gap: 8px; padding: 7px 10px;
    border-radius: 6px; font-size: 12px; color: var(--text2); cursor: pointer;
    transition: background .12s;
  }
  .history-item:hover { background: var(--surface2); color: var(--text); }
  .history-icon { font-size: 12px; opacity: .6; }

  /* TURN DEPTH CHART */
  .turn-chart { padding: 16px 18px; display: flex; gap: 3px; align-items: flex-end; height: 120px; }
  .turn-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .turn-bar {
    width: 100%; background: var(--accent); border-radius: 3px 3px 0 0;
    transition: height .4s ease; cursor: pointer; position: relative;
  }
  .turn-bar:hover { background: var(--accent2); }
  .turn-bar.gpt4 { background: var(--purple); }
  .turn-bar.gpt4:hover { background: #5E35B1; }
  .turn-xlabel { font-size: 9px; color: var(--text3); font-family: 'DM Mono', monospace; }
  .chart-legend { display: flex; gap: 12px; padding: 0 18px 12px; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: 10.5px; color: var(--text2); }
  .legend-swatch { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

  /* SUMMARY STATS */
  .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px; }
  .stat-box {
    background: var(--surface2); border-radius: 8px; padding: 12px 14px;
    display: flex; flex-direction: column; gap: 3px; border: 1px solid var(--border);
  }
  .stat-box-val { font-family: 'Sora', sans-serif; font-size: 22px; font-weight: 700; color: var(--text); }
  .stat-box-label { font-size: 10.5px; font-weight: 600; color: var(--text3); text-transform: uppercase; letter-spacing: .04em; }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }

  /* SECTION TABS */
  .tab-row { display: flex; gap: 2px; }
  .tab {
    padding: 5px 12px; border-radius: 6px 6px 0 0; font-size: 11.5px;
    font-weight: 600; cursor: pointer; color: var(--text3); border: 1px solid transparent;
    border-bottom: none; transition: all .12s;
  }
