          <div class="preset-chip" onclick="togglePreset(this)" style="font-size:11px;"><span class="icon">📝</span><span class="label">Writing · GPT-4</span></div>
          <button class="btn btn-outline" style="font-size:11px;padding:5px 10px;margin-top:4px;" onclick="addPreset()">+ Save current filters</button>
        </div>
      </div>
    </div>

    <!-- SESSION HISTORY -->
    <div class="rpanel-section">
      <div class="rpanel-head" onclick="togglePanel(this)">
        <span style="font-size:12px">🕓</span>
        <div class="rpanel-head-title">Session History</div>
        <div class="rpanel-chevron open">▶</div>
      </div>
      <div class="rpanel-body">
        <div class="history-list" style="padding:8px 14px 10px;">
          <div class="history-item" style="font-size:11px;"><span class="history-icon">🔍</span>Searched "transformer"</div>
          <div class="history-item" style="font-size:11px;"><span class="history-icon">🔧</span>Filter: Russia + GPT-4</div>
          <div class="history-item" style="font-size:11px;"><span class="history-icon">👁</span>Opened a1b2c3d4...</div>
          <div class="history-item" style="font-size:11px;"><span class="history-icon">🌍</span>Drilled into Hong Kong</div>
          <div class="history-item" style="font-size:11px;"><span class="history-icon">🔍</span>Searched "coding"</div>
        </div>
      </div>
    </div>

  </aside>

</div>

<script>
// ── DATA ──
const conversations = [
  { hash:'a1b2c3d4', model:'GPT-3.5', modelClass:'gpt35', lang:'English', langFlag:'', turns:4, country:'United States', countryFlag:'🇺🇸', status:'ok',
    messages:[
      {role:'user',text:'Can you explain how transformers work in ML?'},
      {role:'assistant',text:'Transformers use self-attention mechanisms to process sequences in parallel. Unlike RNNs, they don\'t process tokens sequentially — every token attends to every other token simultaneously...'},
      {role:'user',text:'What\'s the difference between encoder and decoder?'},
      {role:'assistant',text:'The encoder reads the input and builds context representations. The decoder generates outputs, attending to encoder outputs via cross-attention mechanisms...'}
    ]
  },
  { hash:'e5f6a7b8', model:'GPT-4', modelClass:'gpt4', lang:'Chinese', langFlag:'', turns:7, country:'Hong Kong', countryFlag:'🇭🇰', status:'ok',
    messages:[
      {role:'user',text:'请帮我写一首关于秋天的诗'},
      {role:'assistant',text:'秋风轻抚落叶黄，枫林尽染夕阳光。寒露晨凝草尖上，归雁声声过远方。'},
      {role:'user',text:'能解释一下这首诗的意境吗？'},
      {role:'assistant',text:'这首诗描绘了秋天的典型景象：落叶飘零、枫林红遍、晨露凝草、雁阵南飞...'}
    ]
  },
  { hash:'c9d0e1f2', model:'GPT-3.5', modelClass:'gpt35', lang:'Russian', langFlag:'', turns:2, country:'Russia', countryFlag:'🇷🇺', status:'redacted',
    messages:[
      {role:'user',text:'Как работает машинное обучение?'},
      {role:'assistant',text:'Машинное обучение — это раздел искусственного интеллекта, где алгоритмы обучаются на данных без явного программирования...'}
    ]
  },
  { hash:'g3h4i5j6', model:'GPT-4', modelClass:'gpt4', lang:'French', langFlag:'', turns:11, country:'France', countryFlag:'🇫🇷', status:'ok',
    messages:[
      {role:'user',text:'Pouvez-vous m\'aider à écrire un rapport sur le changement climatique?'},
      {role:'assistant',text:'Bien sûr! Le changement climatique est l\'un des défis les plus urgents de notre époque. Je vais vous aider à structurer un rapport complet...'},
      {role:'user',text:'Quelles sont les principales causes?'},
      {role:'assistant',text:'Les principales causes du changement climatique sont les émissions de gaz à effet de serre, notamment le CO2 provenant des combustibles fossiles...'}
    ]
  },
  { hash:'k7l8m9n0', model:'GPT-3.5', modelClass:'gpt35', lang:'English', langFlag:'', turns:3, country:'United Kingdom', countryFlag:'🇬🇧', status:'ok',
    messages:[
      {role:'user',text:'Write a Python function to sort a list'},
      {role:'assistant',text:'Here\'s a Python function using quicksort:\n\ndef quicksort(arr):\n    if len(arr) <= 1:\n        return arr\n    pivot = arr[len(arr)//2]\n    left = [x for x in arr if x < pivot]\n    middle = [x for x in arr if x == pivot]\n    right = [x for x in arr if x > pivot]\n    return quicksort(left) + middle + quicksort(right)'},
      {role:'user',text:'Can you add type hints?'},
      {role:'assistant',text:'Sure! Here\'s the typed version with full annotations...'}
    ]
  },
  { hash:'p1q2r3s4', model:'GPT-4', modelClass:'gpt4', lang:'German', langFlag:'', turns:5, country:'Germany', countryFlag:'🇩🇪', status:'ok',
    messages:[
      {role:'user',text:'Erkläre mir die Quantenmechanik'},
      {role:'assistant',text:'Die Quantenmechanik ist die fundamentale Theorie der Physik, die das Verhalten von Materie und Energie auf atomarer Ebene beschreibt...'}
    ]
  },
];

let selectedRow = null;

// ── RENDER TABLE ──
function renderTable(data) {
  const tbody = document.getElementById('convBody');
  tbody.innerHTML = '';
  data.forEach((c, i) => {
    const tr = document.createElement('tr');
    if (selectedRow === i) tr.classList.add('selected');
    tr.onclick = () => selectConversation(i, tr);
    tr.innerHTML = `
      <td><span class="hash-code">${c.hash}...</span></td>
      <td><span class="model-tag ${c.modelClass}">${c.model}</span></td>
      <td><span class="lang-tag">${c.lang}</span></td>
      <td style="font-family:'DM Mono',monospace;font-size:11.5px;">${c.turns}</td>
      <td><span class="country-flag">${c.countryFlag}</span>${c.country}</td>
      <td><span class="status-dot ${c.status}">${c.status}</span></td>
    `;
    tbody.appendChild(tr);
  });
}

renderTable(conversations);

// ── SELECT CONVERSATION ──
function selectConversation(i, tr) {
  selectedRow = i;
  const c = conversations[i];

  // Highlight row
  document.querySelectorAll('#convBody tr').forEach(r => r.classList.remove('selected'));
  tr.classList.add('selected');

  // Update preview
  document.getElementById('previewHash').textContent = c.hash;
  document.getElementById('previewModel').textContent = c.model;
  document.getElementById('previewLang').textContent = c.lang;
  document.getElementById('previewCountry').textContent = c.countryFlag + ' ' + c.country;
  document.getElementById('previewTurns').textContent = c.turns + ' turns';

  const chatEl = document.getElementById('chatPreview');
  chatEl.innerHTML = c.messages.map(m => `
    <div>
      <div class="msg-role ${m.role}">${m.role === 'user' ? 'User' : c.model}</div>
      <div class="msg-bubble ${m.role}" style="white-space:pre-wrap;">${m.text}</div>
    </div>
  `).join('');

  // Switch to preview tab
  switchTab(document.querySelector('.tab.active'), 'preview');
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelector('.tab').classList.add('active');

  // Update right panel
  document.getElementById('rpSelectedId').textContent = c.hash + ' · ' + c.country;
  document.getElementById('rpModel').textContent = c.model;
  document.getElementById('rpLang').textContent = c.lang;
  document.getElementById('rpCountry').textContent = c.countryFlag + ' ' + c.country;
  document.getElementById('rpTurns').textContent = c.turns;
  document.getElementById('rpStatus').textContent = c.status.toUpperCase();
  document.getElementById('rpStatus').style.color = c.status === 'redacted' ? 'var(--red)' : 'var(--green)';
  document.getElementById('rpGraphs').style.display = 'block';

  // Build sparklines
  buildSentiment(c.turns);
  buildLengthSpark(c.messages);

  // Auto-fill translator
  if (c.messages.length > 0) {
    document.getElementById('transInput').value = c.messages[0].text;
  }
}

function buildSentiment(turns) {
  const el = document.getElementById('sentimentSpark');
  const heights = Array.from({length: turns}, () => 30 + Math.random()*60);
  const colors = heights.map(h => h > 60 ? 'high' : h > 40 ? 'med' : 'low');
  el.innerHTML = heights.map((h,i) => `<div class="spark-bar ${colors[i]}" style="height:${h}%"></div>`).join('');
}

function buildLengthSpark(msgs) {
  const el = document.getElementById('lenSpark');
  const heights = msgs.map(m => Math.min(100, (m.text.length / 200) * 100));
  el.innerHTML = heights.map(h => `<div class="spark-bar" style="height:${Math.max(10,h)}%;background:var(--teal)"></div>`).join('');
}

// ── FILTER ──
function filterUpdate() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const filtered = q ? conversations.filter(c =>
    c.hash.includes(q) || c.country.toLowerCase().includes(q) ||
    c.lang.toLowerCase().includes(q) || c.model.toLowerCase().includes(q)
  ) : conversations;
  renderTable(filtered);
  document.getElementById('filterCount').textContent = filtered.length.toLocaleString() + ' records';
  document.getElementById('tableCount').textContent = '— ' + filtered.length.toLocaleString() + ' records';
}

function removeTag(el) {
  el.style.opacity = '0.4';
  el.style.textDecoration = 'line-through';
  setTimeout(() => el.remove(), 300);
}

function addFilter() {
  const val = document.getElementById('searchInput').value.trim();
  if (!val) return;
  const bar = document.querySelector('.filter-bar');
  const addBtn = bar.querySelector('.btn-outline');
  const tag = document.createElement('div');
  tag.className = 'filter-tag';
  tag.innerHTML = `${val} <span class="remove">×</span>`;
  tag.onclick = () => removeTag(tag);
  bar.insertBefore(tag, addBtn);
  document.getElementById('searchInput').value = '';
}

function applyPreset(el, name) {
  document.querySelectorAll('.nav-pill').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
}

// ── COUNTRY SELECT ──
function selectCountry(name, flag) {
  const info = document.getElementById('countryInfo');
  info.innerHTML = `<span style="font-size:18px">${flag}</span> <strong>${name}</strong> selected — filtering conversations... <button class="btn btn-outline" style="font-size:11px;padding:4px 8px;margin-left:8px;" onclick="clearCountry(this.parentElement)">✕ Clear</button>`;

  const filtered = conversations.filter(c => c.country === name || c.country.includes(name.split(' ')[0]));
  if (filtered.length > 0) renderTable(filtered);
}

function clearCountry(el) {
  el.innerHTML = '<span style="font-size:18px">🌍</span><span>Click a bubble to filter conversations by country</span>';
  renderTable(conversations);
}

// ── MAP TOOLTIP ──
const tooltip = document.getElementById('tooltip');
function showTip(e, text) {
  tooltip.textContent = text;
  tooltip.style.display = 'block';
  moveTip(e);
}
function hideTip() { tooltip.style.display = 'none'; }
document.addEventListener('mousemove', e => {
  if (tooltip.style.display === 'block') {
    tooltip.style.left = (e.clientX + 12) + 'px';
    tooltip.style.top = (e.clientY - 28) + 'px';
  }
});
function moveTip(e) {
  tooltip.style.left = (e.clientX + 12) + 'px';
  tooltip.style.top = (e.clientY - 28) + 'px';
}

// ── NAV ──
function setNav(el) {
  document.querySelectorAll('.topnav .nav-pill').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
}
function setActive(el) {
  document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
}

// ── TABS ──
function switchTab(el, id) {
  document.querySelectorAll('.card-header .tab').forEach(t => t.classList.remove('active'));
  if (el) el.classList.add('active');
  ['preview','flow','translator'].forEach(t => {
    const el = document.getElementById('tab-'+t);
    if (el) el.style.display = t === id ? 'flex' : 'none';
    if (el && t !== 'preview') el.style.display = t === id ? 'block' : 'none';
  });
}

// ── PANEL TOGGLE ──
function togglePanel(head) {
  const body = head.nextElementSibling;
  const chevron = head.querySelector('.rpanel-chevron');
  if (body.classList.contains('hidden')) {
    body.classList.remove('hidden');
    chevron.classList.add('open');
  } else {
    body.classList.add('hidden');
    chevron.classList.remove('open');
  }
}

// ── PRESETS ──
function togglePreset(el) {
  el.classList.toggle('active');
}

// ── MAP MODE ──
function setMapMode(el, mode) {
  document.querySelectorAll('.card-header .nav-pill').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
}

// ── DATE SLIDER ──
function sliderClick(e) {
  const track = e.currentTarget;
  const rect = track.getBoundingClientRect();
  const pct = Math.round(((e.clientX - rect.left) / rect.width) * 100);
  console.log('Slider at', pct + '%');
}

let animating = false;
function animateSlider() {
  if (animating) return;
  animating = true;
  let pos = 0;
  const fill = document.getElementById('rangeFill');
  const thumbR = document.getElementById('thumbR');
  const interval = setInterval(() => {
    pos = (pos + 1) % 100;
    const w = Math.min(pos, 80);
    fill.style.left = '10%';
    fill.style.width = w + '%';
    thumbR.style.left = (10 + w) + '%';
    if (pos >= 80) { clearInterval(interval); animating = false; }
  }, 20);
}

// ── TRANSLATOR ──
function swapLangs() {
  const from = document.getElementById('fromLang');
  const to = document.getElementById('toLang');
  const tmp = from.value;
  from.value = to.value;
  to.value = tmp;
}

function clearOutput() {
  document.getElementById('transOutput').innerHTML = '<span style="color:var(--text3);font-style:normal;">Translation will appear here...</span>';
}

async function translateText() {
  const text = document.getElementById('transInput').value.trim();
  const toLang = document.getElementById('toLang').value;
  if (!text) return;

  const out = document.getElementById('transOutput');
  out.innerHTML = '<span class="trans-loading"><span class="spin">⟳</span> Translating...</span>';

  try {
    const resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{
          role: 'user',
          content: `Translate the following text to ${toLang}. Return ONLY the translation, nothing else:\n\n${text}`
        }]
      })
    });
    const data = await resp.json();
    const translation = data.content?.[0]?.text || 'Translation unavailable';
    out.innerHTML = `<span style="font-style:normal;">${translation}</span>`;
  } catch(e) {
    out.innerHTML = `<span style="color:var(--text3);font-style:normal;">Translation service unavailable in preview. In production, this connects to the translation API.</span>`;
  }
}

function translateConv() {
  if (selectedRow === null) {
    document.getElementById('transOutput').innerHTML = '<span style="color:var(--orange);font-style:normal;">Please select a conversation first.</span>';
    return;
  }
  const c = conversations[selectedRow];
  const text = c.messages.map(m => `[${m.role.toUpperCase()}]: ${m.text}`).join('\n\n');
  document.getElementById('transInput').value = text;
  translateText();
}

// ── ANNOTATION ──
function addAnnotation() {
  const note = prompt('Add annotation note:');
  if (!note) return;
  const list = document.querySelector('.annotation-list');
  const addBtn = list.querySelector('.ann-add');
  const item = document.createElement('div');
  item.className = 'annotation-item info';
  item.innerHTML = `<div class="ann-icon">📌</div><div class="ann-text">${note}</div>`;
  list.insertBefore(item, addBtn);
}

// ── PRESET SAVE ──
function addPreset() {
  const name = prompt('Name this preset:');
  if (!name) return;
  alert(`Preset "${name}" saved!`);
}

// ── SHARE ──
function showShare() {
  alert('Share link copied to clipboard!\nhttps://wildchat-lens.example.com/share/abc123');
}

// ── INIT ──
// select first row
setTimeout(() => {
  const firstRow = document.querySelector('#convBody tr');
  if (firstRow) selectConversation(0, firstRow);
}, 100);
</script>
